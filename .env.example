# ============================================================
# PR Review Agent — environment variables
#
# Copy this file to `.env`, fill in the secret values, and
# `source .env` (or use direnv / dotenv-cli) before running
# `cdk deploy` from infrastructure/. The CDK stack pulls these
# from your shell at synth time and bakes them into the Lambda
# config. See infrastructure/cdk/stacks/lambda-api.stack.ts.
#
# `.env` is gitignored. Never commit real secret values.
# ============================================================


# ------------------------------------------------------------
# REQUIRED — Claude API
# ------------------------------------------------------------
# Get from: https://console.anthropic.com/settings/keys
# The Anthropic SDK reads this automatically via `new Anthropic()`.
ANTHROPIC_API_KEY=

# Override the default model used by every agent.
# Default: claude-sonnet-4-6 (set in shared/anthropic.ts)
# CLAUDE_MODEL=claude-sonnet-4-6


# ------------------------------------------------------------
# REQUIRED — GitHub
# ------------------------------------------------------------
# Personal Access Token OR GitHub App installation token.
# Used by api/mcp/Github.mcp.client.ts to post PR comments via
# GitHub's hosted Copilot MCP server.
#
# For a PAT (fastest path): https://github.com/settings/tokens
#   Scopes needed: repo (full), read:org
GITHUB_TOKEN=

# Shared secret you configured when creating the GitHub webhook
# (PR Review Agent → repo Settings → Webhooks → Secret).
# Used by api/middlewares/webhook.middleware.ts to verify the
# X-Hub-Signature-256 header. Generate with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=


# ------------------------------------------------------------
# OPTIONAL — Slack (escalation notifications)
# ------------------------------------------------------------
# Bot token (xoxb-…) for a Slack app with chat:write scope.
# Leave blank to disable Slack escalations entirely.
SLACK_BOT_TOKEN=

# Channel where escalation alerts land. Default: #pr-review-escalations
# SLACK_ESCALATION_CHANNEL=#pr-review-escalations


# ------------------------------------------------------------
# REQUIRED for deploy — AWS
# ------------------------------------------------------------
# Region you want the stack deployed to. AWS_REGION is also
# auto-injected by Lambda at runtime — only needed in your
# shell for `cdk deploy`.
AWS_REGION=us-east-1

# CDK picks app environment up from this. Drives Lambda naming
# (`pr-review-orchestrator-${APP_ENV}`), reserved concurrency,
# and log levels.
APP_ENV=development


# ------------------------------------------------------------
# OPTIONAL — Runtime tuning (defaults in code; uncomment to override)
# ------------------------------------------------------------
# Max diff size before the orchestrator posts a size warning
# instead of running the pipeline. Default: 3000
# MAX_DIFF_LINES=3000

# Aggregator escalates the PR below this confidence. Default: 0.75
# MIN_CONFIDENCE_THRESHOLD=0.75

# Ralph loop ceiling per SubAgent. Default: 3
# MAX_RALPH_ITERATIONS=3

# DynamoDB session TTL (seconds). Default: 172800 (48h)
# SESSION_TTL_SECONDS=172800

# Shadow mode — pipeline runs but no comment is posted to GitHub.
# Flip to 'true' for the 2-week soak in PLAN.md Phase 7; 'false' for
# the real launch. Read at call time, so you can change it on a live
# Lambda without redeploying.
# SHADOW_MODE=false

# Log level: 'debug' | 'info' | 'warn' | 'error'
# Default: 'debug' when APP_ENV != production, 'info' otherwise
# LOG_LEVEL=debug
