{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Style SubAgent Schemas",
  "description": "Input and output contracts for the Style SubAgent",

  "StyleAgentInput": {
    "type": "object",
    "required": ["session_id", "pr_metadata", "diff_content", "iteration"],
    "properties": {
      "session_id": {
        "type": "string",
        "description": "Unique session ID from Orchestrator"
      },
      "pr_metadata": {
        "type": "object",
        "required": ["pr_number", "repo", "sender"],
        "properties": {
          "pr_number": { "type": "integer" },
          "repo": { "type": "string" },
          "sender": { "type": "string" },
          "base_branch": { "type": "string" },
          "head_branch": { "type": "string" },
          "diff_line_count": { "type": "integer" }
        }
      },
      "diff_content": {
        "type": "string",
        "description": "Raw PR diff content to review"
      },
      "iteration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "description": "Current Ralph loop iteration number"
      },
      "previous_findings": {
        "type": ["array", "null"],
        "description": "Findings from previous Ralph loop iteration for refinement",
        "items": { "$ref": "#/StyleFinding" }
      }
    }
  },

  "StyleAgentOutput": {
    "type": "object",
    "required": ["agent", "session_id", "confidence", "findings", "iteration", "verdict"],
    "properties": {
      "agent": {
        "type": "string",
        "const": "style"
      },
      "session_id": {
        "type": "string"
      },
      "confidence": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "findings": {
        "type": "array",
        "items": { "$ref": "#/StyleFinding" }
      },
      "iteration": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "ralph_loop_complete": {
        "type": "boolean"
      },
      "verdict": {
        "type": "string",
        "enum": ["APPROVED", "CHANGES_REQUESTED"]
      },
      "checkpoint_saved": {
        "type": "boolean"
      }
    }
  },

  "StyleFinding": {
    "type": "object",
    "required": ["severity", "category", "file", "line", "description", "suggestion", "blocks_pr"],
    "properties": {
      "severity": {
        "type": "string",
        "enum": ["MEDIUM", "LOW", "INFO"],
        "description": "Style findings never reach CRITICAL or HIGH"
      },
      "category": {
        "type": "string",
        "enum": [
          "NO_ANY_TYPE",
          "MISSING_ERROR_HANDLING",
          "UNUSED_IMPORT",
          "FUNCTION_TOO_LONG",
          "SINGLE_LETTER_VARIABLE",
          "MISSING_TYPE_HINT",
          "BARE_EXCEPT",
          "MISSING_DOCSTRING",
          "MUTABLE_DEFAULT_ARG",
          "COMMENTED_OUT_CODE",
          "HARDCODED_URL",
          "MISSING_ENV_EXAMPLE",
          "CONSOLE_LOG_IN_PROD",
          "SINGLE_RESPONSIBILITY",
          "MISSING_TESTS",
          "PEP8_VIOLATION"
        ]
      },
      "file": {
        "type": "string",
        "description": "Relative file path from repo root"
      },
      "line": {
        "type": "integer",
        "description": "Exact line number in the diff"
      },
      "description": {
        "type": "string"
      },
      "suggestion": {
        "type": "string"
      },
      "blocks_pr": {
        "type": "boolean",
        "const": false,
        "description": "Always false — style findings never block a PR"
      }
    }
  }
}